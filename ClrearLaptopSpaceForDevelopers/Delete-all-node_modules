

$drives = Get-PSDrive -PSProvider FileSystem | Where-Object { $_.Used -gt 0 }
$skip = @("OneDrive")

Write-Host "`n=== Scanning for node_modules... ===" -ForegroundColor Cyan

$found = @()
foreach ($drive in $drives) {
    Get-ChildItem -Path "$($drive.Root)" -Filter "node_modules" -Recurse -Directory -ErrorAction SilentlyContinue |
    Where-Object { $skip -notcontains ($_.FullName -split '\\')[2] -and
                   $_.FullName -notlike "*\OneDrive\*" } |
    ForEach-Object { $found += $_ }
}

$totalSize = ($found | ForEach-Object {
    (Get-ChildItem $_.FullName -Recurse -ErrorAction SilentlyContinue | Measure-Object -Property Length -Sum).Sum
} | Measure-Object -Sum).Sum

Write-Host "`nFound $($found.Count) node_modules folders"
Write-Host "Total size: $([math]::Round($totalSize/1GB, 2)) GB`n" -ForegroundColor Yellow

foreach ($folder in $found) {
    Write-Host "  $($folder.FullName)" -ForegroundColor Gray
}

$confirm = Read-Host "`nDelete ALL of the above? (yes/no)"
if ($confirm -eq "yes") {
    foreach ($folder in $found) {
        Write-Host "Deleting: $($folder.FullName)" -ForegroundColor Red
        Remove-Item $folder.FullName -Recurse -Force -ErrorAction SilentlyContinue
    }
    Write-Host "`nDone! Freed $([math]::Round($totalSize/1GB, 2)) GB" -ForegroundColor Green
} else {
    Write-Host "Cancelled." -ForegroundColor Yellow
}
